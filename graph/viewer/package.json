{
  "name": "rootstock-viewer",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.18"
  },
  "scripts": {
    "lint": "biome lint eslint.config.mjs css src scripts && eslint .",
    "format:check": "biome format eslint.config.mjs css src scripts",
    "typecheck": "tsc --noEmit",
    "bundle:css": "node scripts/bundle-viewer-css.mjs",
    "bundle:js": "node scripts/bundle-viewer-js.mjs",
    "bundle": "npm run bundle:css && npm run bundle:js",
    "demo:build": "node scripts/build-pages-demo.mjs",
    "demo:verify": "node scripts/check-pages-demo.mjs",
    "demo:screenshots": "node scripts/capture-demo-screenshots.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "typescript": "npm:@typescript/typescript6@6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
