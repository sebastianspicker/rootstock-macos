# Rootstock environment variables
#
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# Usage:
#   cp .env.example .env
#   set -a
#   . ./.env
#   set +a
#   bash graph/pipeline.sh scan.json

# Neo4j connection (required for graph pipeline, API server, and reports).
# Use the same password as NEO4J_AUTH=neo4j/<password> for the bundled
# local Docker Compose setup.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME

# Required when running rootstock-graph-api or graph/pipeline.sh --serve.
ROOTSTOCK_API_TOKEN=CHANGE_ME

# Provision a separate read-only Neo4j principal before starting the API.
# See docs/CONFIGURATION.md for the required permissions.
NEO4J_READ_USER=rootstock_reader
NEO4J_READ_PASSWORD=CHANGE_ME
